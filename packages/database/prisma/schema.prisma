// CREASPARK EDUCORE™ — Core multi-tenant schema
// Tenancy model: shared database, row-level isolation via tenantId
// on every tenant-scoped table, enforced by API middleware + Prisma
// client extension (see apps/api/src/common/tenancy).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ────────────────────────── Tenancy ──────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  name        String                       // e.g. "Sunrise Education Trust"
  slug        String   @unique             // subdomain: sunrise.educore.in
  logoUrl     String?
  brandColor  String   @default("#2F6FB8")
  plan        Plan     @default(STARTER)
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schools     School[]
  users       User[]
  userAccess  UserAccess[]
  assetItems  AssetItem[]
}

enum Plan {
  STARTER
  GROWTH
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

model School {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  code      String                          // school short-code, unique per tenant
  institutionType InstitutionType @default(SCHOOL)
  logoUrl   String?
  board     Board    @default(CBSE)
  address   String?
  city      String?
  state     String?
  country   String?
  pincode   String?
  phone     String?
  email     String?
  academicYearStart Int @default(4)         // April (Indian AY)
  createdAt DateTime @default(now())

  classes       Class[]
  students      Student[]
  staff         StaffProfile[]
  feePlans      FeePlan[]
  announcements Announcement[]
  events        Event[]
  visitors      Visitor[]
  academicYears AcademicYear[]
  portionReports PortionReport[]
  lessons       Lesson[]
  assignments   Assignment[]
  quizzes       Quiz[]
  subjectViews  SubjectView[]
  subjects      Subject[]
  media         MediaItem[]
  inventoryItems InventoryItem[]
  trainings     Training[]
  userAccess    UserAccess[]
  assetAllocations AssetAllocation[]
  assetTransactions AssetTransaction[]
  salesLeadsConverted SalesLead[]
  salesActivities  SalesActivity[]
  salesFollowUps   SalesFollowUp[]
  salesOpportunities SalesOpportunity[]
  yearlyPlanAssignments YearlyPlanAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

enum Board {
  CBSE
  ICSE
  IB
  IGCSE
  STATE
  OTHER
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  INSTITUTE
  CENTRE
  COMPANY
}

// ────────────────────────── Identity & RBAC ──────────────────────────

// id is the Supabase auth.users UUID — this row mirrors identity for
// relational queries; Supabase Auth is the source of truth for credentials.
model User {
  id           String   @id
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  phone        String?
  fullName     String
  gender       Gender?
  avatarUrl    String?
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffProfile      StaffProfile?
  studentLink       Student?       @relation("StudentUser")
  guardianLinks     Guardian[]
  auditLogs         AuditLog[]
  messagesSent      Message[]      @relation("MessagesSent")
  messagesReceived  Message[]      @relation("MessagesReceived")
  announcementReads AnnouncementRead[]
  portionReportsSubmitted PortionReport[] @relation("PortionReportsByTeacher")
  portionReportsReviewed  PortionReport[] @relation("PortionReportsReviewed")
  lessonsAuthored         Lesson[] @relation("LessonsAuthored")
  assignmentsAuthored     Assignment[] @relation("AssignmentsAuthored")
  quizzesAuthored         Quiz[] @relation("QuizzesAuthored")
  teacherAssignments      TeacherAssignment[] @relation("TeacherAssignments")
  taskAssignments         TaskAssignee[]
  tasksCreated            TaskItem[] @relation("TasksCreated")
  tasksUpdated            TaskItem[] @relation("TasksUpdatedBy")
  trainingsConducted      Training[] @relation("TrainingsConducted")
  trainingFeedback        TrainingFeedback[]
  userAccess              UserAccess[]
  salarySlipsReceived     SalarySlipLog[] @relation("SalarySlipsFor")
  salarySlipsGenerated    SalarySlipLog[] @relation("SalarySlipsGeneratedBy")
  salaryCertificatesReceived  SalaryCertificateLog[] @relation("SalaryCertificatesFor")
  salaryCertificatesGenerated SalaryCertificateLog[] @relation("SalaryCertificatesGeneratedBy")
  holidaysCreated             Holiday[] @relation("HolidaysCreated")
  assetItemsCreated           AssetItem[] @relation("AssetItemsCreated")
  assetItemsUpdated           AssetItem[] @relation("AssetItemsUpdatedBy")
  assetAllocationsMade        AssetAllocation[] @relation("AssetAllocationsMade")
  assetTransactionsRecorded   AssetTransaction[] @relation("AssetTransactionsRecorded")
  salesActivities             SalesActivity[] @relation("SalesActivitiesByUser")
  salesFollowUps              SalesFollowUp[] @relation("SalesFollowUpsAssigned")
  salesLeadsAssigned          SalesLead[] @relation("SalesLeadsAssigned")
  salesOpportunitiesAssigned  SalesOpportunity[] @relation("SalesOpportunitiesAssigned")
  salesDailyReports           SalesDailyReport[] @relation("SalesDailyReportsBy")
  salesDailyReportsReviewed   SalesDailyReport[] @relation("SalesDailyReportsReviewed")
  salesTargetsFor             SalesTarget[] @relation("SalesTargetsFor")
  salesTargetsCreatedBy       SalesTarget[] @relation("SalesTargetsCreatedBy")
  yearlyPlanGradesCreated     YearlyPlanGrade[] @relation("YearlyPlanGradesCreated")
  yearlyPlanTeacherAssignments YearlyPlanAssignment[] @relation("YearlyPlanTeacherAssignments")

  @@index([tenantId, role])
}

// Coarse roles; fine-grained permissions live in Permission/RolePermission
enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  VICE_PRINCIPAL
  COORDINATOR
  TEACHER
  TRAINER
  ACCOUNTANT
  RECEPTION
  LIBRARIAN
  TRANSPORT_MANAGER
  HR
  INVENTORY_MANAGER
  HOSTEL_WARDEN
  SECURITY
  SALES_EXECUTIVE
  SALES_MANAGER
  PARENT
  STUDENT
  GUEST
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String                          // e.g. "student.create"
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ────────────────────────── Academics ──────────────────────────

model Class {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  name     String                           // "Grade 6"
  sections Section[]
  portionReports PortionReport[]
  lessons     Lesson[]
  assignments Assignment[]
  quizzes     Quiz[]
  subjectViews SubjectView[]

  @@unique([schoolId, name])
  @@index([tenantId])
}

model Section {
  id       String @id @default(cuid())
  tenantId String
  classId  String
  class    Class  @relation(fields: [classId], references: [id])
  name     String                           // "A"
  classTeacherId String?

  students    Student[]
  attendance  AttendanceRecord[]
  messages    Message[]
  portionReports PortionReport[]
  teacherAssignments TeacherAssignment[]

  @@unique([classId, name])
  @@index([tenantId])
}

// Global shared catalog -- one flat list of department names used
// identically across every school/institute/college/center, not duplicated
// per school (same convention as Subject).
model Department {
  id   String @id @default(cuid())
  name String @unique

  taskLinks TaskDepartment[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  tenantId  String
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  label     String                          // "2026-27"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([schoolId, label])
  @@index([tenantId, schoolId])
}

model Subject {
  id       String @id @default(cuid())
  tenantId String                          // home tenant (creator, for audit attribution)
  name     String
  code     String?
  schools  School[]                        // schools/colleges/institutes this subject is assigned to (cross-tenant)
  exams    ExamSubject[]
  portionReports PortionReport[]
  lessons     Lesson[]
  assignments Assignment[]
  quizzes     Quiz[]
  subjectViews SubjectView[]
  teacherAssignments TeacherAssignment[]

  @@index([tenantId])
}

// Which teacher teaches a given Subject to a given Section (class ×
// division) — the "Assign Subjects & Class to Teachers" screen. One
// teacher per subject per section at a time; re-assigning overwrites the
// existing row rather than erroring, since swapping who teaches a slot is
// the normal edit, not a conflict.
model TeacherAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  teacherId String
  teacher   User     @relation("TeacherAssignments", fields: [teacherId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])
  createdAt DateTime @default(now())

  @@unique([sectionId, subjectId])
  @@index([tenantId, teacherId])
}

// ────────────────────────── People ──────────────────────────

model Student {
  id             String   @id @default(cuid())
  tenantId       String
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  sectionId      String?
  section        Section? @relation(fields: [sectionId], references: [id])
  userId         String?  @unique
  user           User?    @relation("StudentUser", fields: [userId], references: [id])
  admissionNo    String
  // Platform-generated, distinct from admissionNo (school-assigned) and
  // rollNo (class-assigned) — a stable identifier that never changes even
  // if a student moves school/class or admissionNo gets corrected.
  registerNo     String   @unique @default(dbgenerated("('REG-' || lpad(nextval('student_register_seq')::text, 6, '0'))"))
  rollNo         String?
  firstName      String
  lastName       String
  gender         Gender?
  dob            DateTime?
  bloodGroup     String?
  house          String?
  photoUrl       String?
  admissionDate  DateTime @default(now())
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guardians   Guardian[]
  attendance  AttendanceRecord[]
  invoices    FeeInvoice[]
  examResults ExamResult[]
  lessonCompletions      LessonCompletion[]
  assignmentSubmissions  Submission[]
  quizAttempts           QuizAttempt[]
  subjectViews           SubjectView[]

  @@unique([schoolId, admissionNo])
  @@index([tenantId, schoolId, sectionId])
  @@index([tenantId, lastName, firstName])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  ALUMNI
  SUSPENDED
}

model Guardian {
  id        String  @id @default(cuid())
  tenantId  String
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  relation  String                          // Father / Mother / Guardian
  fullName  String
  phone     String
  email     String?
  isPrimary Boolean @default(false)

  @@index([tenantId, studentId])
}

model StaffProfile {
  id         String  @id @default(cuid())
  tenantId   String
  schoolId   String
  school     School  @relation(fields: [schoolId], references: [id])
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id])
  employeeNo String
  designation String
  department String?
  employmentType EmploymentType @default(PERMANENT)
  salaryPaidBy   SalaryPaidBy   @default(SCHOOL)
  salary     Decimal? @db.Decimal(10, 2)
  joinDate   DateTime @default(now())
  lastWorkingDate DateTime?

  @@unique([schoolId, employeeNo])
  @@index([tenantId])
}

enum EmploymentType {
  PERMANENT
  TEMPORARY
}

enum SalaryPaidBy {
  COMPANY
  SCHOOL
}

// One row per salary slip PDF actually generated -- an audit trail separate
// from AuditLog so HR can see "who printed whose slip, and when" as its own
// list without filtering the generic log by action string. storagePath
// points at the actual generated PDF in the private "salary-documents"
// Supabase Storage bucket, so a past slip can be re-previewed/downloaded
// (via a server-issued signed URL) instead of only showing metadata.
model SalarySlipLog {
  id            String   @id @default(cuid())
  tenantId      String
  employeeId    String
  employee      User     @relation("SalarySlipsFor", fields: [employeeId], references: [id])
  generatedById String
  generatedBy   User     @relation("SalarySlipsGeneratedBy", fields: [generatedById], references: [id])
  period        String
  storagePath   String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([employeeId])
}

// Same audit-trail purpose as SalarySlipLog, for salary certificates.
model SalaryCertificateLog {
  id            String   @id @default(cuid())
  tenantId      String
  employeeId    String
  employee      User     @relation("SalaryCertificatesFor", fields: [employeeId], references: [id])
  generatedById String
  generatedBy   User     @relation("SalaryCertificatesGeneratedBy", fields: [generatedById], references: [id])
  refNo         String?
  storagePath   String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([employeeId])
}

// One row per (school, role) a staff member can act as -- lets a person hold
// several roles across several schools/institutes/colleges/centers at once.
// StaffProfile remains the mirror of whichever grant here is isPrimary, so
// the ~30 existing modules reading StaffProfile/User.role need no changes;
// this table is additive. Partial unique indexes (one primary grant per
// user; employeeNo unique per school when set) are hand-written in the
// migration SQL -- Prisma can't express a WHERE clause on @@unique.
model UserAccess {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  schoolId    String?                        // null = tenant-wide grant (e.g. ORG_ADMIN)
  school      School?  @relation(fields: [schoolId], references: [id])
  role        Role
  designation String?
  department  String?
  employeeNo  String?
  isPrimary   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, tenantId, schoolId, role])
  @@index([userId])
  @@index([tenantId, schoolId, role])
}

// ────────────────────────── Attendance ──────────────────────────

model AttendanceRecord {
  id        String   @id @default(cuid())
  tenantId  String
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  date      DateTime @db.Date
  status    AttendanceStatus
  method    AttendanceMethod @default(MANUAL)
  markedBy  String?                          // userId of teacher
  note      String?
  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@index([tenantId, sectionId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum AttendanceMethod {
  MANUAL
  RFID
  QR
  BIOMETRIC
  FACE
  GPS
}

// ────────────────────────── Fees ──────────────────────────

model FeePlan {
  id        String  @id @default(cuid())
  tenantId  String
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])
  name      String                          // "Grade 6 Annual Plan 2026-27"
  academicYear String                       // "2026-27"
  items     FeePlanItem[]
  invoices  FeeInvoice[]

  @@index([tenantId, schoolId])
}

model FeePlanItem {
  id        String  @id @default(cuid())
  planId    String
  plan      FeePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  label     String                          // Tuition / Transport / Lab
  amount    Decimal @db.Decimal(12, 2)
  dueMonth  Int?                            // 1–12, null = one-time
}

model FeeInvoice {
  id          String   @id @default(cuid())
  tenantId    String
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  planId      String?
  plan        FeePlan? @relation(fields: [planId], references: [id])
  invoiceNo   String
  amount      Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  fine        Decimal  @default(0) @db.Decimal(12, 2)
  dueDate     DateTime
  status      InvoiceStatus @default(PENDING)
  payments    Payment[]
  createdAt   DateTime @default(now())

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, studentId, status])
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model Payment {
  id         String   @id @default(cuid())
  tenantId   String
  invoiceId  String
  invoice    FeeInvoice @relation(fields: [invoiceId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  mode       PaymentMode
  reference  String?                        // gateway txn id / cheque no
  paidAt     DateTime @default(now())
  receivedBy String?                        // userId

  @@index([tenantId, invoiceId])
}

enum PaymentMode {
  CASH
  UPI
  CARD
  NETBANKING
  CHEQUE
  RAZORPAY
  STRIPE
}

// ────────────────────────── Exams ──────────────────────────

model Exam {
  id        String @id @default(cuid())
  tenantId  String
  schoolIdRef String
  name      String                          // "Term 1 2026"
  startDate DateTime?
  endDate   DateTime?
  subjects  ExamSubject[]

  @@index([tenantId, schoolIdRef])
}

model ExamSubject {
  id        String  @id @default(cuid())
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  maxMarks  Int     @default(100)
  results   ExamResult[]
}

model ExamResult {
  id            String      @id @default(cuid())
  tenantId      String
  examSubjectId String
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id])
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  marks         Decimal     @db.Decimal(6, 2)
  grade         String?
  remark        String?

  @@unique([examSubjectId, studentId])
  @@index([tenantId, studentId])
}

// ────────────────────────── Generic module records ──────────────────────────
// Backs every sidebar leaf that doesn't have a dedicated model yet (Library,
// Transport, Inventory, ...). Once a module graduates to a real schema, its
// records can be migrated out and this table drops out of use for that key.

model GenericRecord {
  id        String   @id @default(cuid())
  tenantId  String
  module    String                          // e.g. "library-books", "transport-routes"
  data      Json
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, module])
}

// ────────────────────────── Communication ──────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  tenantId  String
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  title     String
  body      String
  audience  Role[]                           // which roles see it
  pinned    Boolean  @default(false)
  createdBy String?
  createdAt DateTime @default(now())

  reads     AnnouncementRead[]

  @@index([tenantId, schoolId, createdAt])
}

// Per-user read receipt — Announcement is a broadcast (audience: Role[]),
// so "read" can't live on the Announcement row itself.
model AnnouncementRead {
  id             String   @id @default(cuid())
  tenantId       String
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime @default(now())

  @@unique([announcementId, userId])
  @@index([tenantId, userId])
}

model Event {
  id          String   @id @default(cuid())
  tenantId    String
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  title       String
  category    EventCategory @default(GENERAL)
  description String?
  location    String?
  photoUrl    String?
  pdfUrl      String?
  startAt     DateTime
  endAt       DateTime?
  registrationDeadline DateTime?
  audience    Role[]                          // which roles see it; empty = everyone
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, schoolId, startAt])
}

enum EventCategory {
  COMPETITION
  CONFERENCE
  EXHIBITION
  GENERAL
}

// Tenant-wide (not per-school) -- a holiday closes the whole organization,
// unlike Event which is one school's activity. images is a flat list of
// Supabase Storage public URLs (browser uploads directly, same convention
// as School.logoUrl), since a holiday can carry several photos/notices.
model Holiday {
  id          String   @id @default(cuid())
  tenantId    String
  subject     String
  description String?
  remarks     String?
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  images      String[]
  createdById String
  createdBy   User     @relation("HolidaysCreated", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([tenantId, startDate])
}

// Photo/video gallery — uploaded by staff (Super/Org/School Admin, Teacher),
// viewable by the wider school community (+ Parent, Student).
model MediaItem {
  id          String    @id @default(cuid())
  tenantId    String
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  title       String
  description String?
  type        MediaType
  url         String
  uploadedBy  String
  createdAt   DateTime  @default(now())

  @@index([tenantId, schoolId, createdAt])
}

enum MediaType {
  PHOTO
  VIDEO
}

// Physical stock tracked and distributed to a specific school/college/institute.
model InventoryItem {
  id          String   @id @default(cuid())
  tenantId    String
  schoolId    String                          // distributed to this school
  school      School   @relation(fields: [schoolId], references: [id])
  name        String
  category    String?                         // free-text, picked from the existing Category list on the frontend
  description String?
  quantity    Int      @default(1)
  imageUrl    String?
  submittedAt DateTime @default(now())        // date of submission
  remarks     String?
  comments    String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, schoolId, submittedAt])
}

model Visitor {
  id            String    @id @default(cuid())
  tenantId      String
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  visitorName   String
  phone         String
  purpose       String
  personToMeet  String?
  idProofType   String?
  idProofNumber String?
  checkInAt     DateTime  @default(now())
  checkOutAt    DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, schoolId, checkInAt])
}

// A row is either a direct message (recipientId set, sectionId null) or a
// broadcast to a whole class section (sectionId set, recipientId null).
model Message {
  id          String    @id @default(cuid())
  tenantId    String
  senderId    String
  sender      User      @relation("MessagesSent", fields: [senderId], references: [id])
  recipientId String?
  recipient   User?     @relation("MessagesReceived", fields: [recipientId], references: [id])
  sectionId   String?
  section     Section?  @relation(fields: [sectionId], references: [id])
  subject     String?
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, recipientId, createdAt])
  @@index([tenantId, sectionId, createdAt])
  @@index([tenantId, senderId, createdAt])
}

// ────────────────────────── Syllabus / Portion Tracking ──────────────────────────
// A teacher's self-reported record of how much of a subject's syllabus they've
// covered, submitted daily or weekly. School management reviews each entry —
// this IS the "report" (the review trail on the row), not a separate document.

model PortionReport {
  id              String   @id @default(cuid())
  tenantId        String
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  teacherId       String
  teacher         User     @relation("PortionReportsByTeacher", fields: [teacherId], references: [id])
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id])
  classId         String?
  class           Class?   @relation(fields: [classId], references: [id])
  sectionId       String?
  section         Section? @relation(fields: [sectionId], references: [id])
  period          PortionPeriod @default(DAILY)
  periodDate      DateTime @db.Date               // the day, or the week's start date
  chapterName     String?                         // the chapter/portion this entry is about
  description     String?                         // what the chapter covers, independent of this period's topics
  topicsCovered   String
  percentComplete Int?                            // teacher's own 0–100 estimate
  mode            PortionMode?                    // Practical (lab) vs Theory (classroom)
  completionStatus PortionCompletionStatus?        // progress on the chapter as a whole
  status          PortionStatus @default(SUBMITTED)
  reviewedBy      String?
  reviewer        User?    @relation("PortionReportsReviewed", fields: [reviewedBy], references: [id])
  reviewedAt      DateTime?
  reviewNote      String?
  reviewComments  String?                         // reviewer's freeform comments, separate box from remarks
  reviewRemarks   String?                         // reviewer's freeform remarks, separate box from comments
  createdAt       DateTime @default(now())

  @@index([tenantId, schoolId, periodDate])
  @@index([tenantId, teacherId, periodDate])
}

enum PortionPeriod {
  DAILY
  WEEKLY
}

enum PortionStatus {
  SUBMITTED
  REVIEWED
  FLAGGED
}

enum PortionMode {
  PRACTICAL
  THEORY
}

enum PortionCompletionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// ────────────────────────── LMS ──────────────────────────
// Lesson/Assignment/Quiz content lives directly on a Subject, scoped to a
// school and, optionally, one class (null = whole school), and to the
// teacher who authored it — mirrors how PortionReport/Announcement already
// target either a specific class or the broader school. Each item publishes
// independently (no shared course-level gate); teachers see and edit their
// own DRAFT items freely. subjectId stays nullable at the DB level only to
// protect pre-existing rows migrated from the old subject-less Course rows;
// create DTOs require it going forward.

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Lesson {
  id        String   @id @default(cuid())
  tenantId  String
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id])
  teacherId String
  teacher   User     @relation("LessonsAuthored", fields: [teacherId], references: [id])
  title     String
  content   String?
  videoUrl  String?
  order     Int      @default(0)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime @default(now())

  completions LessonCompletion[]

  @@index([tenantId, subjectId, schoolId, classId, order])
  @@index([tenantId, teacherId])
}

// Per-student "read" marker for a lesson — same shape as AnnouncementRead.
model LessonCompletion {
  id          String   @id @default(cuid())
  tenantId    String
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([lessonId, studentId])
  @@index([tenantId, studentId])
}

model Assignment {
  id          String   @id @default(cuid())
  tenantId    String
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     User     @relation("AssignmentsAuthored", fields: [teacherId], references: [id])
  title       String
  description String?
  dueDate     DateTime?
  maxMarks    Int?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime @default(now())

  submissions Submission[]

  @@index([tenantId, subjectId, schoolId, classId])
  @@index([tenantId, teacherId])
}

model Submission {
  id            String     @id @default(cuid())
  tenantId      String
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content       String?
  attachmentUrl String?
  submittedAt   DateTime   @default(now())
  status        SubmissionStatus @default(SUBMITTED)
  marksAwarded  Int?
  feedback      String?
  gradedAt      DateTime?
  gradedBy      String?

  @@unique([assignmentId, studentId])
  @@index([tenantId, studentId])
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
}

model Quiz {
  id          String   @id @default(cuid())
  tenantId    String
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     User     @relation("QuizzesAuthored", fields: [teacherId], references: [id])
  title       String
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime @default(now())

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([tenantId, subjectId, schoolId, classId])
  @@index([tenantId, teacherId])
}

// `options` holds the MCQ choices as a JSON string[]; `correctAnswer` matches
// one of them for auto-grading. SHORT_ANSWER questions carry no
// correctAnswer — they're excluded from the auto-computed score in v1.
model QuizQuestion {
  id            String   @id @default(cuid())
  tenantId      String
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText  String
  type          QuestionType @default(MCQ)
  options       Json?
  correctAnswer String?
  marks         Int      @default(1)
  order         Int      @default(0)

  @@index([tenantId, quizId, order])
}

enum QuestionType {
  MCQ
  SHORT_ANSWER
}

// One attempt per student per quiz in v1 — no retakes. `answers` is a JSON
// map of questionId -> the student's answer string.
model QuizAttempt {
  id          String   @id @default(cuid())
  tenantId    String
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     Json
  score       Int?
  submittedAt DateTime @default(now())

  @@unique([quizId, studentId])
  @@index([tenantId, studentId])
}

// One row per student per subject+school+class combo — records that a
// student has opened that subject's content at least once, so teachers can
// see who never looked at it. classId is nullable (whole-school content),
// so uniqueness is enforced in the service layer (find-then-create) rather
// than a DB constraint, which would treat distinct NULLs as non-duplicate.
model SubjectView {
  id        String   @id @default(cuid())
  tenantId  String
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@index([tenantId, subjectId, schoolId, classId, studentId])
}

// ────────────────────────── Task Manager ──────────────────────────
// Standalone work-assignment tracker between users -- unrelated to
// PortionReport (that's a teacher's own syllabus-coverage log; this is one
// person assigning a task to another and tracking it to completion).

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TaskItem {
  id           String     @id @default(cuid())
  tenantId     String
  serialNo     String     @unique @default(dbgenerated("('TASK-' || lpad(nextval('task_serial_seq')::text, 6, '0'))"))
  subject      String
  description  String?
  departments  TaskDepartment[]
  targetDate   DateTime?  @db.Date
  assignees    TaskAssignee[]
  assignedById String
  assignedBy   User       @relation("TasksCreated", fields: [assignedById], references: [id])
  updatedById  String?
  updatedBy    User?      @relation("TasksUpdatedBy", fields: [updatedById], references: [id])
  remarks      String?
  status       TaskStatus @default(OPEN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  salesActivity SalesActivity?

  @@index([tenantId, status])
  @@index([tenantId, assignedById])
}

// Many-to-many: one task can span several departments (e.g. a task that's
// simultaneously HR's and IT's business at the same school). Explicit join
// model, matching this schema's convention (UserAccess, TeacherAssignment,
// ExamSubject) rather than Prisma's implicit m2m.
model TaskDepartment {
  id           String     @id @default(cuid())
  taskId       String
  task         TaskItem   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([taskId, departmentId])
  @@index([departmentId])
}

// Many-to-many: one task can be assigned to several people at once. Each
// assignee tracks their OWN reply (status/remarks/respondedAt) independently
// of TaskItem.status -- so a manager can see who has responded and who is
// still pending on a task with multiple assignees, not just one shared status.
model TaskAssignee {
  id          String     @id @default(cuid())
  taskId      String
  task        TaskItem   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  status      TaskStatus @default(OPEN)
  remarks     String?
  respondedAt DateTime?

  @@unique([taskId, userId])
  @@index([userId])
}

// ────────────────────────── Training & Feedback ──────────────────────────
// Super Admin conducts a training targeted at a chosen audience (roles
// and/or a single school; both empty/null = everyone platform-wide).
// Creating one notifies the matched audience (same Message/bell reuse as
// Task Manager's notifyAssignee), who each submit one structured feedback
// response.

model Training {
  id             String   @id @default(cuid())
  tenantId       String
  title          String
  description    String?
  conductedAt    DateTime
  conductedById  String
  conductedBy    User     @relation("TrainingsConducted", fields: [conductedById], references: [id])
  targetRoles    Role[]
  targetSchoolId String?
  targetSchool   School?  @relation(fields: [targetSchoolId], references: [id])
  createdAt      DateTime @default(now())

  feedback TrainingFeedback[]

  @@index([targetSchoolId])
}

model TrainingFeedback {
  id               String   @id @default(cuid())
  tenantId         String
  trainingId       String
  training         Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  respondentId     String
  respondent       User     @relation(fields: [respondentId], references: [id])
  contentRating    Int
  trainerRating    Int
  usefulnessRating Int
  overallRating    Int
  comments         String?
  submittedAt      DateTime @default(now())

  @@unique([trainingId, respondentId])
  @@index([tenantId, trainingId])
}

// ────────────────────────── Asset Management / Inventory ──────────────────────────
// Category -> Item -> Stock -> School Allocation -> Distribution. AssetCategory,
// Vendor and Location are global shared catalogs (same pattern as Department) --
// promoted from the generic-scaffold GenericRecord rows that used to back the
// Asset Management > Vendor/Location/Asset Category sidebar pages, so the two
// existing categories ("IoT Kit", "Avishkar Bundle Kit") carry over via a
// backfill migration rather than being replaced. AssetItem is the centrally
// managed stock (tenant-owned, cross-tenant visible to SUPER_ADMIN/ORG_ADMIN
// like Training/Tasks); allocated/delivered/available quantities are DERIVED
// from AssetAllocation at query time rather than stored redundantly on
// AssetItem, so they can never drift out of sync with the underlying rows.

model AssetCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items AssetItem[]
}

model Vendor {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items AssetItem[]
}

model Location {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items AssetItem[]
}

model AssetItem {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  itemCode          String        @unique
  itemName          String
  assetCategoryId   String
  assetCategory     AssetCategory @relation(fields: [assetCategoryId], references: [id])
  description       String?
  brand             String?
  model             String?
  unit              String        @default("unit")
  totalQuantity     Int           @default(0)
  damagedQuantity   Int           @default(0)
  lostQuantity      Int           @default(0)
  returnedQuantity  Int           @default(0)
  reorderLevel      Int?
  locationId        String?
  location          Location?     @relation(fields: [locationId], references: [id])
  vendorId          String?
  vendor            Vendor?       @relation(fields: [vendorId], references: [id])
  status            String        @default("ACTIVE")
  notes             String?
  // Auditability for source-imported rows (Section 24 of the inventory spec) --
  // left null for items created directly through the UI.
  sourceFile        String?
  sourceItemName    String?
  importNotes       String?
  createdById       String
  createdBy         User          @relation("AssetItemsCreated", fields: [createdById], references: [id])
  updatedById       String?
  updatedBy         User?         @relation("AssetItemsUpdatedBy", fields: [updatedById], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  allocations  AssetAllocation[]
  transactions AssetTransaction[]

  @@index([tenantId, assetCategoryId])
}

enum AssetAllocationStatus {
  PENDING
  PARTIALLY_DELIVERED
  DELIVERED
}

// One row per (item, school) -- tracks allocation and physical delivery
// independently, per the spec's core distinction between "allocated" and
// "delivered".
model AssetAllocation {
  id                String                 @id @default(cuid())
  assetItemId       String
  assetItem         AssetItem              @relation(fields: [assetItemId], references: [id], onDelete: Cascade)
  schoolId          String
  school            School                 @relation(fields: [schoolId], references: [id])
  allocatedQuantity Int
  deliveredQuantity Int                    @default(0)
  status            AssetAllocationStatus  @default(PENDING)
  allocatedById     String
  allocatedBy       User                   @relation("AssetAllocationsMade", fields: [allocatedById], references: [id])
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([assetItemId, schoolId])
  @@index([schoolId])
}

enum AssetTransactionType {
  RECEIVED
  ADJUSTMENT
  ALLOCATION
  ALLOCATION_CANCELLED
  DISTRIBUTION
  PARTIAL_DISTRIBUTION
  RETURN
  DAMAGE
  LOST
  TRANSFER
}

// Append-only ledger -- every stock movement creates a row here so nothing
// changes stock silently (Section 20/32 of the spec).
model AssetTransaction {
  id            String               @id @default(cuid())
  assetItemId   String
  assetItem     AssetItem            @relation(fields: [assetItemId], references: [id], onDelete: Cascade)
  type          AssetTransactionType
  quantity      Int
  schoolId      String?
  school        School?              @relation(fields: [schoolId], references: [id])
  reference     String?
  remarks       String?
  userId        String
  user          User                 @relation("AssetTransactionsRecorded", fields: [userId], references: [id])
  previousValue Int?
  newValue      Int?
  createdAt     DateTime             @default(now())

  @@index([assetItemId, createdAt])
}

// ────────────────────────── Sales Management & Daily Activity Tracking ──────────────────────────
// SalesActivity is the single source of truth for "what a salesperson did"
// (calls, visits, meetings, demos, proposals, ...). Visit check-in/check-out
// live directly on the activity row rather than a separate table, since a
// visit IS an activity -- location is captured ONLY at check-in/check-out,
// never polled continuously (no background GPS tracking). SalesFollowUp is
// a distinct queryable table powering the Follow-up Center (Today/Upcoming/
// Overdue/Completed) -- created standalone or auto-generated from an
// activity's nextFollowUpDate. Daily-report and target ACHIEVEMENT numbers
// are always derived live from SalesActivity/SalesOpportunity rows at read
// time, never stored redundantly, so they can't drift out of sync (same
// principle as Asset Management's derived stock quantities above).

enum SalesActivityType {
  CALL
  SCHOOL_VISIT
  CUSTOMER_VISIT
  MEETING
  ONLINE_MEETING
  PRODUCT_DEMO
  EMAIL
  MESSAGE
  FOLLOW_UP
  LEAD_CREATION
  PROPOSAL
  QUOTATION
  NEGOTIATION
  DELIVERY
  TRAINING_DEMO
  OTHER
}

enum SalesLeadSource {
  WEBSITE
  REFERRAL
  DIRECT_CONTACT
  EVENT
  SCHOOL_VISIT
  EXISTING_CUSTOMER
  CAMPAIGN
  OTHER
}

enum SalesLeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUALIFIED
  CONVERTED
  LOST
}

enum SalesOpportunityStage {
  LEAD
  CONTACTED
  INTERESTED
  MEETING
  DEMO
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum SalesFollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SalesReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum SalesTargetPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum SalesTargetMetric {
  CALLS
  VISITS
  MEETINGS
  LEADS
  DEMOS
  PROPOSALS
  CONVERSIONS
  REVENUE
}

enum SalesPriority {
  LOW
  MEDIUM
  HIGH
}

// A potential customer/school, not necessarily a registered School yet --
// salespeople work leads before they become real accounts. convertedSchoolId
// links to the real School once registered (reusing the existing School
// module rather than duplicating it).
model SalesLead {
  id                String           @id @default(cuid())
  tenantId          String
  schoolName        String
  contactPerson     String?
  phone             String?
  email             String?
  location          String?
  source            SalesLeadSource  @default(OTHER)
  status            SalesLeadStatus  @default(NEW)
  priority          SalesPriority    @default(MEDIUM)
  notes             String?
  assignedToId      String
  assignedTo        User             @relation("SalesLeadsAssigned", fields: [assignedToId], references: [id])
  convertedSchoolId String?
  convertedSchool   School?          @relation(fields: [convertedSchoolId], references: [id])
  leadDate          DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  activities    SalesActivity[]
  opportunities SalesOpportunity[]
  followUps     SalesFollowUp[]

  @@index([tenantId, assignedToId, status])
}

model SalesActivity {
  id               String            @id @default(cuid())
  tenantId         String
  userId           String
  user             User              @relation("SalesActivitiesByUser", fields: [userId], references: [id])
  type             SalesActivityType
  schoolId         String?
  school           School?           @relation(fields: [schoolId], references: [id])
  leadId           String?
  lead             SalesLead?        @relation(fields: [leadId], references: [id])
  opportunityId    String?
  opportunity      SalesOpportunity? @relation(fields: [opportunityId], references: [id])
  contactPerson    String?
  purpose          String?
  description      String?
  outcome          String?
  activityDate     DateTime          @default(now())
  startTime        DateTime?
  endTime          DateTime?
  checkInAt        DateTime?
  checkInLat       Float?
  checkInLng       Float?
  checkOutAt       DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  nextAction       String?
  nextFollowUpDate DateTime?
  priority         SalesPriority     @default(MEDIUM)
  status           TaskStatus        @default(OPEN)
  generatedTaskId  String?           @unique
  generatedTask    TaskItem?         @relation(fields: [generatedTaskId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  followUp SalesFollowUp?

  @@index([tenantId, userId, activityDate])
  @@index([tenantId, schoolId])
}

// A scheduled future action, created standalone or auto-generated from an
// activity's nextFollowUpDate -- powers the Follow-up Center as one
// queryable table (Today/Upcoming/Overdue derived from dueDate + status at
// query time; never silently changed).
model SalesFollowUp {
  id                  String              @id @default(cuid())
  tenantId            String
  userId              String
  user                User                @relation("SalesFollowUpsAssigned", fields: [userId], references: [id])
  schoolId            String?
  school              School?             @relation(fields: [schoolId], references: [id])
  leadId              String?
  lead                SalesLead?          @relation(fields: [leadId], references: [id])
  opportunityId       String?
  opportunity         SalesOpportunity?   @relation(fields: [opportunityId], references: [id])
  sourceActivityId    String?             @unique
  sourceActivity      SalesActivity?      @relation(fields: [sourceActivityId], references: [id])
  nextAction          String
  dueDate             DateTime
  priority            SalesPriority       @default(MEDIUM)
  status              SalesFollowUpStatus @default(PENDING)
  completedAt         DateTime?
  completedActivityId String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([tenantId, userId, status, dueDate])
}

model SalesOpportunity {
  id                  String                @id @default(cuid())
  tenantId            String
  title               String
  schoolId            String?
  school              School?               @relation(fields: [schoolId], references: [id])
  leadId              String?
  lead                SalesLead?            @relation(fields: [leadId], references: [id])
  value               Decimal?              @db.Decimal(12, 2)
  stage               SalesOpportunityStage @default(LEAD)
  probability         Int                   @default(10)
  expectedClosingDate DateTime?
  nextAction          String?
  nextFollowUpDate    DateTime?
  assignedToId        String
  assignedTo          User                  @relation("SalesOpportunitiesAssigned", fields: [assignedToId], references: [id])
  wonAt               DateTime?
  lostAt              DateTime?
  lostReason          String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  activities SalesActivity[]
  followUps  SalesFollowUp[]

  @@index([tenantId, assignedToId, stage])
}

model SalesDailyReport {
  id                 String            @id @default(cuid())
  tenantId           String
  userId             String
  user               User              @relation("SalesDailyReportsBy", fields: [userId], references: [id])
  reportDate         DateTime          @db.Date
  status             SalesReportStatus @default(DRAFT)
  achievements       String?
  majorOpportunities String?
  challenges         String?
  supportRequired    String?
  tomorrowPriorities String?
  tomorrowPlan       String?
  managerComments    String?
  reviewedById       String?
  reviewedBy         User?             @relation("SalesDailyReportsReviewed", fields: [reviewedById], references: [id])
  submittedAt        DateTime?
  reviewedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([userId, reportDate])
  @@index([tenantId, reportDate])
}

model SalesTarget {
  id          String            @id @default(cuid())
  tenantId    String
  userId      String?
  user        User?             @relation("SalesTargetsFor", fields: [userId], references: [id])
  period      SalesTargetPeriod
  periodStart DateTime          @db.Date
  periodEnd   DateTime          @db.Date
  metric      SalesTargetMetric
  targetValue Decimal           @db.Decimal(12, 2)
  createdById String
  createdBy   User              @relation("SalesTargetsCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, period, periodStart, metric])
  @@index([tenantId, period, periodStart])
}

// Global catalog (not tenant-scoped) -- the curriculum is authored once by
// CREASPARK and applies uniformly across every client school, same pattern
// as AssetCategory/Vendor/Location. One row per grade per academic year.
model YearlyPlanGrade {
  id           String   @id @default(cuid())
  academicYear String
  gradeLabel   String
  sortOrder    Int      @default(0)
  sourceFile   String?
  createdById  String
  createdBy    User     @relation("YearlyPlanGradesCreated", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries     YearlyPlanEntry[]
  assignments YearlyPlanAssignment[]

  @@unique([academicYear, gradeLabel])
}

// Which school + teacher is responsible for delivering a given grade's
// plan. A grade can have several rows (multiple schools, or a school with
// more than one teacher covering it); teacherId is validated server-side
// to actually belong to schoolId's staff.
model YearlyPlanAssignment {
  id        String          @id @default(cuid())
  gradeId   String
  grade     YearlyPlanGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School          @relation(fields: [schoolId], references: [id])
  teacherId String
  teacher   User            @relation("YearlyPlanTeacherAssignments", fields: [teacherId], references: [id])
  createdAt DateTime        @default(now())

  @@unique([gradeId, schoolId, teacherId])
  @@index([schoolId])
  @@index([teacherId])
}

// One row per week/unit of the plan. Source spreadsheets vary in column
// layout across grades (Subject present or not, Digital Content only in
// Grade 7, etc.) -- fields are nullable to accommodate that instead of
// forcing every grade into an identical shape.
model YearlyPlanEntry {
  id              String          @id @default(cuid())
  gradeId         String
  grade           YearlyPlanGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  rowIndex        Int
  term            String?
  month           String?
  week            String?
  workingDays     Int?
  instructedDays  Int?
  subject         String?
  unitChapter     String?
  learningOutcome String?
  activity        String?
  sdgMapping      String?
  skills          String?
  values          String?
  digitalContent  String?
  assessment      String?
  remarks         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([gradeId, rowIndex])
}
